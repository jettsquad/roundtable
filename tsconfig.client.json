{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": [],
    "allowImportingTsExtensions": true
  },
  "include": [
    "packages/*/src/client/**/*.ts",
    "packages/*/src/client/**/*.tsx",
    "packages/*/src/wire.ts",
    "types/*.d.ts"
  ]
}
