{
  "name": "squad",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/link-dsh.mjs",
    "link-dsh": "node scripts/link-dsh.mjs",
    "install-profile": "node scripts/install-profile.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint . && prettier --check \"packages/**/*.ts\" \"scripts/*.mjs\"",
    "format": "prettier --write \"packages/**/*.ts\" \"scripts/*.mjs\""
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "globals": "^17.11.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.9"
  }
}
