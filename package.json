{
  "name": "squad",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/link-dsh.mjs",
    "link-dsh": "node scripts/link-dsh.mjs",
    "install-profile": "node scripts/install-profile.mjs",
    "ui": "node scripts/build-client.mjs && node scripts/ui.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json",
    "test": "vitest run",
    "lint": "eslint . && prettier --check \"packages/**/*.{ts,tsx,css}\" \"scripts/*.mjs\"",
    "format": "prettier --write \"packages/**/*.{ts,tsx,css}\" \"scripts/*.mjs\"",
    "smoke": "node scripts/smoke.mjs",
    "build:client": "node scripts/build-client.mjs",
    "watch:client": "node scripts/build-client.mjs --watch",
    "build:bundle": "node scripts/build-bundle.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "~18.3.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "globals": "^17.11.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "mammoth": "^1.12.1",
    "pdf-parse": "^2.4.5"
  }
}
