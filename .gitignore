# Browser bundles: build output from packages/*/src/client/. Not committed,
# because a checked-in artifact next to its source drifts from it silently —
# you edit the tsx, nothing changes, and the file that is actually loaded
# still looks plausible.
packages/*/client/

# Which harness build this checkout is linked to. Machine state written by
# link-dsh — a path from one machine tells another machine nothing.
.dsh-link.json
bundle/lib/
bundle/*.tgz
profile/
bundle/LICENSE

